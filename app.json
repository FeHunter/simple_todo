{
  "expo": {
    "name": "simple_todo",
    "slug": "simple_todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "simpletodo",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.felipe_hunter_r.simple_todo"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "351fb58e-4384-4d4f-899d-c99471b6ddc4"
      }
    }
  }
}